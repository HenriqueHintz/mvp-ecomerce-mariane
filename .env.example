# Mariane Cosméticos — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local em desenvolvimento. NUNCA comite chaves reais.

# 1. Banco de Dados (SQLite local por padrão; Cloudflare D1 / Turso em produção)
DATABASE_URL="file:./local.sqlite"

# 2. Gateway de Pagamento Online — Asaas API v3 (Sandbox / Produção)
# Quando vazio, o checkout utiliza o fluxo assistido via WhatsApp ("online em breve").
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY=""
PAYMENT_SANDBOX_MODE=""
PAYMENT_SANDBOX_ENABLED="false"

# Segredo criptográfico para verificação HMAC-SHA256 / token do Webhook (/api/webhooks/pagamento)
PAYMENT_WEBHOOK_SECRET=""
ASAAS_WEBHOOK_TOKEN=""

# Senha administrativa para acesso ao Painel da Loja (/admin/login e /api/admin/*)
ADMIN_PASSWORD=""

# 3. Verificação de E-mail no Checkout (Brevo Transactional HTTP API)
# Sem BREVO_API_KEY em desenvolvimento/testes, o envio é apenas registrado no console com código/PII mascarados.
BREVO_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="Mariane Cosméticos"
CHECKOUT_SECRET=""

# 4. URL Canônica e Contatos Oficiais
# Padrão de produção no MVP: https://mvp-ecomerce-mariane-ne8c.vercel.app
# Ao ativar o domínio próprio, definir NEXT_PUBLIC_SITE_URL na Vercel e configurar redirect 308 de vercel.app para o novo domínio.
NEXT_PUBLIC_SITE_URL="https://mvp-ecomerce-mariane-ne8c.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="5549991251617"
